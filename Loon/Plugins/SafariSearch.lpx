#!name = 快捷搜索
#!desc = 为Safari提供快速切换# g = 谷歌搜索，bi = 百度图片搜索，gi = 谷歌图片搜索，b = Bing搜索，wk = 维基搜索，qm = 七麦搜索，gh = GitHub搜索，无快捷键则默认使用百度搜索
#!openUrl = https://github.com/sunshine970918/RemoveAds
#!author = sunshine970918[https://github.com/sunshine970918/RemoveAds]
#!tag = 去广告
#!system = 
#!system_version = 
#!loon_version = 3.5.1(982)
#!homepage = https://github.com/sunshine970918/RemoveAds
#!icon = https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Safari.png
#!date = 2026-08-24 20:39:23

[Rewrite]
# Safari内输入快捷键+空格+搜索关键词快速指定搜索引擎搜索
# 先进入设置更改Safari默认搜索为DuckDuckGo
# 使用 Loon 3.5.1+ rewrite v2 语法
# 匹配机制：Loon 按顺序执行【所有】匹配成功的 rewrite，最后的 redirect 生效。
# 因此把默认百度规则放在【最前面】，快捷键规则放在【后面】，
# 无快捷键的请求只命中默认规则→百度；带快捷键的请求先命中默认、再被快捷键覆盖→正确引擎。

# 默认：百度搜索（无快捷键时使用，放在最前面兜底）
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=([^&]+).*/i as urlMatch then redirect(302, "https://www.baidu.com/s?wd=${urlMatch.1}")

# g = 谷歌搜索（单字母快捷键必须带空格，避免误匹配 good/google 等普通单词）
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=g(?:\+|%20)([^&]+).*/i as urlMatch then redirect(302, "https://www.google.com/search?q=${urlMatch.1}")
# bi = 百度图片搜索（空格可选：bi关键词 或 bi 关键词 均生效）
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=bi(?:\+|%20)?([^&]+).*/i as urlMatch then redirect(302, "https://image.baidu.com/search/index?tn=baiduimage&word=${urlMatch.1}")
# gi = 谷歌图片搜索
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=gi(?:\+|%20)?([^&]+).*/i as urlMatch then redirect(302, "https://www.google.com/search?&tbm=isch&q=${urlMatch.1}")
# b = Bing搜索（单字母快捷键必须带空格）
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=b(?:\+|%20)([^&]+).*/i as urlMatch then redirect(302, "https://www.bing.com/search?q=${urlMatch.1}")
# wk = 维基搜索
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=wk(?:\+|%20)?([^&]+).*/i as urlMatch then redirect(302, "https://zh.wikipedia.org/wiki/${urlMatch.1}")
# qm = 七麦搜索
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=qm(?:\+|%20)?([^&]+).*/i as urlMatch then redirect(302, "https://www.qimai.cn/search/index/country/cn/search/${urlMatch.1}")
# gh = GitHub搜索
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=gh(?:\+|%20)?([^&]+).*/i as urlMatch then redirect(302, "https://github.com/search?q=${urlMatch.1}")

[MitM]
hostname = duckduckgo.com
